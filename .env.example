# =============================================================================
# AI Pulse — Environment Variables
# IMPORTANT: These are LOCAL DEVELOPMENT defaults only.
# Change ALL credentials before staging or production deployment.
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local to git.
# =============================================================================

# Database (local Docker Compose default — change for prod)
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/aipulse

# Redis (local Docker Compose default)
REDIS_URL=redis://localhost:6379

# Gemini — REQUIRED. Get a key at https://aistudio.google.com/
GEMINI_API_KEY=your-key-here

# Storage — MinIO local dev defaults (change for Cloudflare R2 in prod)
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin
R2_BUCKET=aipulse

# Optional — improves Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=
